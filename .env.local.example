# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Slack (for "Add to Slack" button on landing page and setup page)
NEXT_PUBLIC_SLACK_CLIENT_ID=your_slack_client_id

# Stripe (NamiHR live account)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Random 32-byte hex; generate with: openssl rand -hex 32
SEAT_SYNC_SECRET=

# Site URL (production domain, used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Vercel cron auth (auto-set by Vercel; required for /api/internal/seat-sync-reconcile)
CRON_SECRET=
