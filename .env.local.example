# ── Supabase ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ── Slack ─────────────────────────────────────────────────────────────────
# Used by the "Add to Slack" button on landing + setup pages.
NEXT_PUBLIC_SLACK_CLIENT_ID=your_slack_client_id

# HMAC secret for signing OAuth state (CSRF + replay protection on the Slack
# install flow). MUST be identical in Vercel env and Supabase Edge Function
# secrets — both src/lib/oauth-state.ts and supabase/functions/_shared/oauth-state.ts
# read it and signatures must interoperate. App refuses to boot if unset.
# Generate with: openssl rand -hex 32
OAUTH_STATE_SECRET=

# ── Stripe (NamiHR live account) ──────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Random 32-byte hex; generate with: openssl rand -hex 32
# Authenticates internal seat-sync calls between Slack events and the API.
SEAT_SYNC_SECRET=

# ── URLs ──────────────────────────────────────────────────────────────────
# Production domain. Used for Stripe success/cancel redirects and the
# billing portal return URL.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Where Slack-link magic-link redirects land (the dashboard host). Read by
# /api/auth/slack-link and supabase/functions/slack-oauth. In single-domain
# setups this equals NEXT_PUBLIC_SITE_URL; in split setups it's the dashboard
# subdomain. No trailing slash.
DASHBOARD_URL=https://your-domain.com

# ── Vercel cron ───────────────────────────────────────────────────────────
# Auto-set by Vercel. Required for /api/internal/seat-sync-reconcile.
CRON_SECRET=
