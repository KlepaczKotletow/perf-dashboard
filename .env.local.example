# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Slack (for "Add to Slack" button on landing page and setup page)
NEXT_PUBLIC_SLACK_CLIENT_ID=your_slack_client_id

# Stripe (optional - only needed when enabling paid plans)
# STRIPE_SECRET_KEY=sk_live_or_test_xxx
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_or_test_xxx

# Site URL (production domain, used for Stripe redirects)
NEXT_PUBLIC_SITE_URL=https://your-domain.com
